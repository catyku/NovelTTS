# 複製成 .env 後填入實際值（.env 已在 .gitignore）

POSTGRES_DB=noveltts
POSTGRES_USER=noveltts
POSTGRES_PASSWORD=noveltts_dev_pwd
POSTGRES_EXPOSE_PORT=5432

# API Key 加密主金鑰：openssl rand -base64 32
# ⚠ 必須固定保存，主金鑰變更會導致已加密的 API Key 無法解密
NOVELTTS_MASTER_KEY=

# app 服務
APP_EXPOSE_PORT=8090
NOVELTTS_STORAGE_HOST_PATH=../storage

# 管理帳號密碼已改由資料庫管理（app_user 表，BCrypt 雜湊）。
# 初始帳號 admin / admin，首次登入會強制要求變更密碼。
# 不再需要 NOVELTTS_ADMIN_USERNAME / NOVELTTS_ADMIN_PASSWORD 環境變數。

TZ=Asia/Taipei
