# ============================================================================
# 實際部署環境設定範本
# ============================================================================
#
# 用法：
#   cp .env.example.prod .env.prod
#   然后填入實際值
#
# 注意：.env.prod 已被 .gitignore 的 .env 規則涵蓋（.gitignore 中的 `.env`
# 只匹配名稱完全為 .env 的檔案），因此請確認 .env.prod 也不會被提交：
#   git check-ignore -v WebEnv/.env.prod
# 確認有輸出才安全。
#
# 部署時指定這個 env 檔：
#   podman-compose -f docker-compose.prod.yaml --env-file .env.prod up -d
# ============================================================================

# ---------- PostgreSQL ----------
POSTGRES_DB=noveltts
POSTGRES_USER=noveltts
# 必填。不可使用預設值。產生方式：openssl rand -base64 24
POSTGRES_PASSWORD=

# DB 對主機的映射 port（僅綁 127.0.0.1）
POSTGRES_EXPOSE_PORT=5432

# ---------- API Key 加密主金鑰 ----------
# 必填。openssl rand -base64 32
#
# ⚠️ 主金鑰必須固定保存並備份。丟失或變更後，資料庫中已加密的
#    OpenRouter API Key 將永久無法解密，必須重新輸入。
#    建議：openssl rand -base64 32 | tee ~/.noveltts-master-key
NOVELTTS_MASTER_KEY=

# ---------- app 服務 ----------
# 應用對主機的映射 port（僅綁 127.0.0.1；對外走 Cloudflare Tunnel）
APP_EXPOSE_PORT=8090

TZ=Asia/Taipei

# ---------- 新部署的必要後續設定 ----------
#
# 全新資料庫不會自動建立 AI Provider 與模型設定，必須先到
# 管理介面（https://<你的網域>/settings）設定：
#
#   1. Provider：base_url = https://openrouter.ai/api/v1
#      api_key = 你的 OpenRouter API Key（會以 AES-GCM 加密落庫）
#   2. 分析模型：purpose = ANALYSIS
#      model_id = google/gemini-3-flash-preview
#   3. TTS 模型：purpose = TTS
#      model_id = google/gemini-3.8-flash-tts
#   4. 在設定頁選好旁白音色與全域語氣
#
# 種子帳號為 admin / admin，首次登入會被強制導向變更密碼頁。
# 這是刻意設計：公開部署若沿用預設密碼，等同無密碼。
